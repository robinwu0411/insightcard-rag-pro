# InsightCard RAG Pro — Environment Variables
# Copy to .env and fill in your values, or export directly before docker-compose up
#
# Pipeline: LangGraph StateGraph (see backend/rag/graph.py)
# Nodes: fetch_metric -> build_query -> vector_search -> hybrid_rerank
#         -> build_card -> [conditional: generate_{openai|bedrock|template}] -> save_memory
# Streaming: async astream_events for token-level LLM streaming (ChatOpenAI)

# --- LLM Provider ---
# Default: OpenAI. Supports any OpenAI-compatible API (DeepSeek, Together, etc.)
# To use DeepSeek:
#   OPENAI_API_KEY=sk-your-deepseek-key
#   OPENAI_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#
# To use OpenAI:
#   OPENAI_API_KEY=sk-your-openai-key
#   LLM_MODEL=gpt-4o-mini
#
# To use AWS Bedrock (production):
#   LLM_PROVIDER=bedrock
#   AWS_REGION=us-east-1
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# --- Embedding ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
